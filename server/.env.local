# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
# Use this connection string for local development
MONGODB_URL=mongodb://localhost:27017/jobportal

# JWT Configuration
JWT_SECRET=3f9a7c1d8e4b2f6a9d0c7e5f1a8b3c6d9e2f4a7b1c8d0e6f2a9b5c7d3e1f8a4
JWT_EXPIRE=30d

# Client Configuration
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12

# Instructions:
# 1. For local development, use the above MongoDB URL with local MongoDB instance
# 2. For production with MongoDB Atlas, you need to:
#    - Go to MongoDB Atlas: https://cloud.mongodb.com/
#    - Navigate to your cluster: Cluster0
#    - Go to Network Access -> Add IP Address
#    - Add your current IP address to the whitelist
#    - Update the MONGODB_URL below with your Atlas connection string
#    - Restart the server
